# Configure estes valores no painel Environment do Render.
# Nunca coloque senhas ou conexões reais neste arquivo.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ADMIN_ID=
DISCORD_REDIRECT_URI=https://elysiumjogos.onrender.com/auth/discord/callback
DATABASE_URL=

# Torre de Comando: token privado do bot (configure no Render, nunca no Git).
DISCORD_BOT_TOKEN=
# Canal opcional para arquivar relatórios aprovados.
LEGION_ARCHIVE_CHANNEL_ID=
# false desativa somente a Torre.
LEGION_ENABLED=true

# Optional stable secret for the Runamarca access session; configure privately in Render.
RUNAMARCA_ACCESS_SECRET=

# Optional channel for generic author mentions ONLY when Discord rejects the DM.
# No reason or private edit link is posted to this channel.
LEGION_NOTIFICATION_CHANNEL_ID=
