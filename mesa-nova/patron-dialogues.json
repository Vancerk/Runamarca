  "matchups": [
    {
      "id": "lyrik-marika",
      "first": "lyrik",
      "second": "marika",
      "lines": [
        {
          "speaker": "lyrik",
          "text": "Li em seu livro sobre como o Éter não nasceu para matar. Acredita mesmo nisso?",
          "audio": "audio/intro/lyrik-studio-v2/L01.mp3",
          "durationSeconds": 4.68,
          "recordingCode": "LR01"
        },
        {
          "speaker": "marika",
          "text": "Enquanto não o usarmos apenas para melhorar a vida, estaremos sempre caminhando à regressão.",
          "audio": null,
          "durationSeconds": 6.5
        },
        {
          "speaker": "lyrik",
          "text": "Quero que esteja certa, mas não vejo esse mundo.",
          "audio": "audio/intro/lyrik-studio-v2/L02.mp3",
          "durationSeconds": 2.68,
          "recordingCode": "LR02"
        }
      ]
    },
    {
      "id": "marika-lyrik",
      "first": "marika",
      "second": "lyrik",
      "lines": [
        {
          "speaker": "marika",
          "text": "Você tem arrependimento ou orgulho do que criou?",
          "audio": null,
          "durationSeconds": 3.8
        },
        {
          "speaker": "lyrik",
          "text": "Nada… além de medo.",
          "audio": "audio/intro/lyrik-studio-v2/L03.mp3",
          "durationSeconds": 2.4,
          "recordingCode": "LR03"
        },
        {
          "speaker": "marika",
          "text": "E o que fará a respeito?",
          "audio": null,
          "durationSeconds": 2.8
        }
      ]
    },
    {
      "id": "lyrik-dom",
      "first": "lyrik",
      "second": "dom",
      "lines": [
        {
          "speaker": "lyrik",
          "text": "Aço bem forjado não precisa dessa brutalidade, Dom.",
          "audio": "audio/intro/voz-propria-20261017/L04.mp3",
          "durationSeconds": 3.4522083333333335,
          "recordingCode": "L04"
        },
        {
          "speaker": "dom",
          "text": "Minha corrente funciona muito bem com ela.",
          "audio": "audio/intro/voz-propria-20261017/D01.mp3",
          "durationSeconds": 2.5479583333333333,
          "recordingCode": "D01"
        },
        {
          "speaker": "lyrik",
          "text": "Funcionar é pouco. Até sucata faz barulho.",
          "audio": "audio/intro/voz-propria-20261017/L05.mp3",
          "durationSeconds": 2.6513125,
          "recordingCode": "L05"
        }
      ]
    },
    {
      "id": "dom-lyrik",
      "first": "dom",
      "second": "lyrik",
      "lines": [
        {
          "speaker": "dom",
          "text": "Anão, teu juramento aguenta uma pancada?",
          "audio": "audio/intro/voz-propria-20261017/D02.mp3",
          "durationSeconds": 3.324104166666667,
          "recordingCode": "D02"
        },
        {
          "speaker": "lyrik",
          "text": "Aguenta, e eu quero ver se você aguenta a resposta.",
          "audio": "audio/intro/voz-propria-20261017/L06.mp3",
          "durationSeconds": 3.1413541666666664,
          "recordingCode": "L06"
        },
        {
          "speaker": "dom",
          "text": "Então faz teu pior! Eu não vim admirar tua forja.",
          "audio": "audio/intro/voz-propria-20261017/D03.mp3",
          "durationSeconds": 3.3792708333333334,
          "recordingCode": "D03"
        }
      ]
    },
    {
      "id": "marika-dom",
      "first": "marika",
      "second": "dom",
      "lines": [
        {
          "speaker": "marika",
          "text": "Seu ódio não precisa decidir quem você será, Dom.",
          "audio": "audio/intro/voz-propria-20261017/M04.mp3",
          "durationSeconds": 3.0105,
          "recordingCode": "M04"
        },
        {
          "speaker": "dom",
          "text": "Guarda a lição. Magia é muleta dos fracos.",
          "audio": "audio/intro/voz-propria-20261017/D04.mp3",
          "durationSeconds": 3.4930625,
          "recordingCode": "D04"
        },
        {
          "speaker": "marika",
          "text": "Quando quiser aprender, minha porta estará aberta.",
          "audio": "audio/intro/voz-propria-20261017/M05.mp3",
          "durationSeconds": 3.2450208333333332,
          "recordingCode": "M05"
        }
      ]
    },
    {
      "id": "dom-marika",
      "first": "dom",
      "second": "marika",
      "lines": [
        {
          "speaker": "dom",
          "text": "Sem magia, o que sobra de você, professora?",
          "audio": "audio/intro/voz-propria-20261017/D05.mp3",
          "durationSeconds": 2.7234791666666665,
          "recordingCode": "D05"
        },
        {
          "speaker": "marika",
          "text": "Tudo o que levei uma vida para aprender.",
          "audio": "audio/intro/voz-propria-20261017/M06.mp3",
          "durationSeconds": 2.3975208333333335,
          "recordingCode": "M06"
        },
        {
          "speaker": "dom",
          "text": "Vamos ver quanto disso aguenta uma porrada.",
          "audio": "audio/intro/voz-propria-20261017/D06.mp3",
          "durationSeconds": 2.6670416666666665,
          "recordingCode": "D06"
        }
      ]
    },
    {
      "id": "lyrik-lyrik-duvida",
      "first": "lyrik",
      "second": "lyrik",
      "label": "Espelho · Não parece certo",
      "lines": [
        {
          "speaker": "lyrik",
          "text": "Não parece certo.",
          "audio": "audio/intro/lyrik-studio-v2/L04.mp3",
          "durationSeconds": 1.5,
          "recordingCode": "LR04",
          "role": "first"
        },
        {
          "speaker": "lyrik",
          "text": "Eu ia dizer a mesma coisa!",
          "audio": "audio/intro/lyrik-studio-v2/L05.mp3",
          "durationSeconds": 2.12,
          "recordingCode": "LR05",
          "role": "second"
        },
        {
          "speaker": "lyrik",
          "text": "Deve ser obra da minha mente.",
          "audio": "audio/intro/lyrik-studio-v2/L06.mp3",
          "durationSeconds": 1.68,
          "recordingCode": "LR06",
          "role": "first"
        }
      ]
    },
    {
      "id": "lyrik-lyrik-culpa",
      "first": "lyrik",
      "second": "lyrik",
      "label": "Espelho · Você ainda se culpa?",
      "lines": [
        {
          "speaker": "lyrik",
          "text": "Se isso é real, me diga. Você ainda se culpa?",
          "audio": "audio/intro/lyrik-studio-v2/L07.mp3",
          "durationSeconds": 3.76,
          "recordingCode": "LR07",
          "role": "second"
        },
        {
          "speaker": "lyrik",
          "text": "Você sabe a resposta.",
          "audio": "audio/intro/lyrik-studio-v2/L08.mp3",
          "durationSeconds": 1.6,
          "recordingCode": "LR08",
          "role": "first"
        },
        {
          "speaker": "lyrik",
          "text": "Sei, só estava confirmando.",
          "audio": "audio/intro/lyrik-studio-v2/L09.mp3",
          "durationSeconds": 2.16,
          "recordingCode": "LR09",
          "role": "second"
        }
      ]
    }
  ],
